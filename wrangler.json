{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accounts-tenmyid",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://accounts.ten.my.id",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "accounts-db",
      "database_id": "09932dcd-1caf-4fea-950e-79fc22fa17ae"
    }
  ],
  "routes": [
    {
      "pattern": "accounts.ten.my.id",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
